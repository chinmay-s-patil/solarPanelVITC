FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (-65 0 0);

boundaryField
{

    inlet
    {
        type                fixedNormalInletOutletVelocity;
        fixTangentialInflow yes;
        normalVelocity
        {
            type            fixedValue;
            value           uniform ( -65 0 0 );
        }
        value               uniform ( -65 0 0 );
    }

    outlet
    {
        type        pressureInletOutletVelocity;
        value       $internalField;
    }
    "(walls|constraint)"
    {
        type        symmetry;
        value       $internalField;
    }

    wall
    {
        type        movingWallVelocity;
        value       uniform (0 0 0);
    }
    "(.*SP|bottom|wall|solarPanel)"
    {
        type        movingWallVelocity;
        value       uniform (0 0 0);
    }

    defaultFaces
    {
        type        slip;
        value       $internalField;
    }

}

