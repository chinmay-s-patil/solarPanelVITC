#!/bin/bash
cd "${0%/*}" || exit 1

TARGET_LEVELS=()

while [ $# -gt 0 ]; do
    case "$1" in
        -level|-levels|--level|--levels)
            shift
            while [ $# -gt 0 ] && [[ "$1" != -* ]]; do
                lvl_num=$(echo "$1" | sed 's/[^0-9]//g')
                if [ -n "$lvl_num" ]; then
                    TARGET_LEVELS+=("level${lvl_num}")
                fi
                shift
            done
            ;;
        *)
            shift
            ;;
    esac
done

if [ ${#TARGET_LEVELS[@]} -eq 0 ]; then
    ALL_LEVELS=(level0 level1 level2 level3 level4 level5 level6 level7 level8 level9 level10 level11 level12 level13 level14)
else
    ALL_LEVELS=("${TARGET_LEVELS[@]}")
fi

for lvl in "${ALL_LEVELS[@]}"; do
    if [ -d "$lvl" ]; then
        (
            cd "$lvl" || exit 1
            echo "=========================================="
            basename "$PWD"
            if [ -f "log.checkMesh" ]; then
                grep "cells:" log.checkMesh
            elif command -v checkMesh >/dev/null 2>&1 && [ -d "constant/polyMesh" ]; then
                checkMesh 2>&1 | grep "cells:"
            else
                echo "  No mesh or checkMesh log found."
            fi
        )
    fi
done
