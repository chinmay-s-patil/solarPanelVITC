#------------------------------------------------------------------------------

cd "${0%/*}" || exit 1

# Parse arguments for -level flag
TARGET_LEVELS=()
PASSTHROUGH_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        -level|-levels|--level|--levels)
            shift
            while [ $# -gt 0 ] && [[ "$1" != -* ]]; do
                lvl_num=$(echo "$1" | sed 's/[^0-9]//g')
                if [ -n "$lvl_num" ]; then
                    TARGET_LEVELS+=("level${lvl_num}")
                fi
                shift
            done
            ;;
        *)
            PASSTHROUGH_ARGS+=("$1")
            shift
            ;;
    esac
done

if [ ${#TARGET_LEVELS[@]} -eq 0 ]; then
    ALL_LEVELS=(level0 level1 level2 level3 level4 level5 level6 level7 level8 level9 level10 level11 level12 level13 level14)
else
    ALL_LEVELS=("${TARGET_LEVELS[@]}")
fi

if [ -f "log.allSolve" ]; then
    mv "log.allSolve" "logOld.allSolve"
fi

export TOP_LOGFILE="$(pwd)/log.allSolve"

echo "======================================================================" > "$TOP_LOGFILE"
echo "  Parallel Solver & Mesh Execution for Levels: ${ALL_LEVELS[*]}" >> "$TOP_LOGFILE"
echo "======================================================================" >> "$TOP_LOGFILE"

for lvl in "${ALL_LEVELS[@]}"; do
    if [ -d "$lvl" ]; then
        (
            cd "$lvl" || exit 1
            if [ -f "./Allsolve" ]; then
                ./Allsolve "${PASSTHROUGH_ARGS[@]}"
            fi
        )
    fi
done

echo "" >> "$TOP_LOGFILE"
echo "======================================================================" >> "$TOP_LOGFILE"
echo "  Selected Allsolve Runs Completed!" >> "$TOP_LOGFILE"
echo "======================================================================" >> "$TOP_LOGFILE"
