FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   0.001;

w	1676.4;
h	736.28;
l	828.6;

maxX	#calc "-15*$l";
minX	#calc "4*$l";
maxY	#calc "4*$h";
maxZ	#calc "-2*$w";
minZ	#calc "2*$w";

vertices
(
    ( $maxX	0		$maxZ)   // 0
    ( $minX	0		$maxZ)   // 1
    ( $minX	$maxY	$maxZ)   // 2
    ( $maxX	$maxY	$maxZ)   // 3

    ( $maxX	0		$minZ)   // 4
    ( $minX	0		$minZ)   // 5
    ( $minX	$maxY	$minZ)   // 6
    ( $maxX	$maxY	$minZ)   // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (39 13 26) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (1 5 6 2)   // x = 4000
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (0 3 7 4)   // x = -8000
        );
    }

    bottom
    {
        type wall;
        faces
        (
            (0 4 5 1)   // y = 0
        );
    }

    walls
    {
        type symmetry;
        faces
        (
            (0 1 2 3)   // z = -4000
			(4 7 6 5)   // z = 4000
			(3 2 6 7)   // y = 4000
        );
    }
);

mergePatchPairs
(
);

