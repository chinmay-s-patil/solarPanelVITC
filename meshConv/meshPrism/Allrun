#    \/     M anipulation  |                                                 |
#------------------------------------------------------------------------------

cd "${0%/*}" || exit 1

TARGET_LEVELS=()
PASSTHROUGH_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        -level|-levels|--level|--levels)
            shift
            while [ $# -gt 0 ] && [[ "$1" != -* ]]; do
                arg="$1"
                if [[ "$arg" =~ ^[lL][eE][vV][eE][lL] ]]; then
                    TARGET_LEVELS+=("$arg")
                else
                    TARGET_LEVELS+=("level${arg}")
                fi
                shift
            done
            ;;
        *)
            PASSTHROUGH_ARGS+=("$1")
            shift
            ;;
    esac
done

if [ ${#TARGET_LEVELS[@]} -eq 0 ]; then
    ALL_LEVELS=(level0 level1 level2 level3 level3.5 level4 level4.5 level5 level6)
else
    ALL_LEVELS=("${TARGET_LEVELS[@]}")
fi

echo "======================================================================"
echo "  Allrun: Running Allmesh followed by Allsolve for: ${ALL_LEVELS[*]}"
echo "======================================================================"

./Allmesh "${TARGET_LEVELS[@]/#/-level }" "${PASSTHROUGH_ARGS[@]}"
./Allsolve "${TARGET_LEVELS[@]/#/-level }" "${PASSTHROUGH_ARGS[@]}"

echo "Allrun finished."
