FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

// Geometry
geometry
{
    topSP.stl
    {
        type triSurfaceMesh;
        name topSP;
    }

    bottomSP.stl
    {
        type triSurfaceMesh;
        name bottomSP;
    }

    frontSP.stl
    {
        type triSurfaceMesh;
        name frontSP;
    }

    rearSP.stl
    {
        type triSurfaceMesh;
        name rearSP;
    }

    leftSP.stl
    {
        type triSurfaceMesh;
        name leftSP;
    }

    rightSP.stl
    {
        type triSurfaceMesh;
        name rightSP;
    }

    supportSP.stl
    {
        type triSurfaceMesh;
        name supportSP;
    }

    stumpSP.stl
    {
        type triSurfaceMesh;
        name stumpSP;
    }

    nearBodyBox
    {
        type searchableBox;
        min (-2.0715 0.0 -1.2);
        max ( 2.0715 1.2  1.2);
    }

    wakeBox
    {
        type searchableBox;
        min (-5.7145 0.0 -1.5);
        max ( 0.5 1.5  1.5);
    }
}

// Castellated mesh controls
castellatedMeshControls
{
    maxLocalCells 1000000;
    maxGlobalCells 4000000;
    minRefinementCells 0;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 5;

    features
    (
    );

    refinementSurfaces
    {
        topSP      { level (5 5);
            patchInfo
            {
                type wall;
            }
        }

        bottomSP   { level (5 5);
            patchInfo
            {
                type wall;
            }
        }

        frontSP    { level (5 5);
            patchInfo
            {
                type wall;
            }
        }

        rearSP     { level (5 5);
            patchInfo
            {
                type wall;
            }
        }

        leftSP     { level (5 5);
            patchInfo
            {
                type wall;
            }
        }

        rightSP    { level (5 5);
            patchInfo
            {
                type wall;
            }
        }

        supportSP  { level (5 6);
            patchInfo
            {
                type wall;
            }
        }

        stumpSP    { level (5 6);
            patchInfo
            {
                type wall;
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        nearBodyBox
        {
            mode inside;
            levels ((1E15 1));
        }

        wakeBox
        {
            mode inside;
            levels ((1E15 1));
        }
    }

    locationInMesh (0.05 2.05 0.05);

    allowFreeStandingZoneFaces false;
}

// Snap controls
snapControls
{
    nSmoothPatch 10;
    tolerance 1.5;
    nSolveIter 300;
    nRelaxIter 10;

    nFeatureSnapIter 20;
    implicitFeatureSnap true;
    explicitFeatureSnap false;
    multiRegionFeatureSnap false;
}

// Layer controls
addLayersControls
{
    relativeSizes false;

    layers
    {
        topSP
        {
            nSurfaceLayers 11;
        }
        bottomSP
        {
            nSurfaceLayers 11;
        }
        frontSP
        {
            nSurfaceLayers 11;
        }
        rearSP
        {
            nSurfaceLayers 11;
        }
        leftSP
        {
            nSurfaceLayers 11;
        }
        rightSP
        {
            nSurfaceLayers 11;
        }
        supportSP
        {
            nSurfaceLayers 11;
        }
        stumpSP
        {
            nSurfaceLayers 11;
        }
    }

    expansionRatio              1.2;
    firstLayerThickness         0.000185;
    minThickness                1e-05;
    nGrow                       0;

    featureAngle                130;
    slipFeatureAngle            30;
    nRelaxIter                  5;
    nSmoothSurfaceNormals       1;
    nSmoothNormals              3;
    nSmoothThickness            10;
    maxFaceThicknessRatio       0.5;
    maxThicknessToMedialRatio   0.3;
    minMedialAxisAngle          90;
    minMedianAxisAngle          90;
    nBufferCellsNoExtrude       0;
    nLayerIter                  50;
    nRelaxedIter                20;
}


// Mesh quality controls
meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-9;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.02;
    minVolRatio         0.01;
    minTriangleTwist    -1;

    nSmoothScale        4;
    errorReduction      0.75;

    relaxed
    {
        maxNonOrtho   75;
        minTetQuality -1e30;
        minTwist      -1;
    }
}


// Write flags
writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance 1e-6;

// ************************************************************************* //
