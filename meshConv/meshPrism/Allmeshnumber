#!/bin/bash
cd "${0%/*}" || exit 1

TARGET_LEVELS=()

while [ $# -gt 0 ]; do
    case "$1" in
        -level|-levels|--level|--levels)
            shift
            while [ $# -gt 0 ] && [[ "$1" != -* ]]; do
                arg="$1"
                if [[ "$arg" =~ ^[lL][eE][vV][eE][lL] ]]; then
                    TARGET_LEVELS+=("$arg")
                else
                    TARGET_LEVELS+=("level${arg}")
                fi
                shift
            done
            ;;
        *)
            shift
            ;;
    esac
done

if [ ${#TARGET_LEVELS[@]} -eq 0 ]; then
    ALL_LEVELS=(level0 level1 level2 level3 level3.5 level4 level4.5 level5 level6)
else
    ALL_LEVELS=("${TARGET_LEVELS[@]}")
fi

for lvl in "${ALL_LEVELS[@]}"; do
    if [ -d "$lvl" ]; then
        (
            cd "$lvl" || exit 1
            echo "=========================================="
            basename "$PWD"
            if [ -f "log.checkMesh" ]; then
                grep "cells:" log.checkMesh
            elif command -v checkMesh >/dev/null 2>&1 && [ -d "constant/polyMesh" ]; then
                checkMesh 2>&1 | grep "cells:"
            else
                echo "  No mesh or checkMesh log found."
            fi
        )
    fi
done
