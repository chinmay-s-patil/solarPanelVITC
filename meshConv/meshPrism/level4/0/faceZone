FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       surfaceScalarField;
    location    "0";
    object      faceZone;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform -1;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform -1;
    }
    outlet
    {
        type            calculated;
        value           uniform -1;
    }
    bottom
    {
        type            calculated;
        value           uniform -1;
    }
    walls
    {
        type            symmetry;
        value           uniform -1;
    }
    topSP
    {
        type            calculated;
        value           uniform -1;
    }
    bottomSP
    {
        type            calculated;
        value           uniform -1;
    }
    frontSP
    {
        type            calculated;
        value           uniform -1;
    }
    rearSP
    {
        type            calculated;
        value           uniform -1;
    }
    leftSP
    {
        type            calculated;
        value           uniform -1;
    }
    rightSP
    {
        type            calculated;
        value           uniform -1;
    }
    supportSP
    {
        type            calculated;
        value           uniform -1;
    }
}


